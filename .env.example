NODE_ENV=development
PORT=3000
# ใช้ database แยกของโปรเจกต์นี้ (prisma db push จะลบตารางที่ไม่อยู่ใน schema)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/easy_shop
# frontend ที่อนุญาตให้เรียก API (CORS) และใช้สร้างลิงก์ยืนยันอีเมล
FRONTEND_URL=http://localhost:5173

# อย่างน้อย 32 ตัวอักษร สร้างด้วย: openssl rand -base64 32
ACCESS_JWT_SECRET=
# อายุ access token (วินาที)
ACCESS_JWT_TTL=3600
# อายุลิงก์ยืนยันอีเมล (วินาที)
CONFIRMATION_EMAIL_TOKEN_TTL=86400

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URI=http://localhost:3000/auth/google/callback

COULDINARY_API_KEY=
COULDINARY_API_SECRET=
COULDINARY_NAME=
